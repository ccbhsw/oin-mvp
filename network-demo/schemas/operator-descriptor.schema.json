{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oin.example/schemas/operator-descriptor.schema.json",
  "title": "OIN Local Demo Operator Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_version",
    "operator_id",
    "descriptor_revision",
    "published_at",
    "public_key",
    "capabilities",
    "supported_artifact_types",
    "endpoint"
  ],
  "properties": {
    "descriptor_version": {"const": "1.0"},
    "operator_id": {"type": "string", "pattern": "^did:oin-local:[a-z0-9-]+$"},
    "descriptor_revision": {"type": "integer", "minimum": 1},
    "published_at": {"type": "string", "format": "date-time"},
    "public_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key_base64"],
      "properties": {
        "algorithm": {"const": "Ed25519"},
        "key_id": {"type": "string", "minLength": 1},
        "public_key_base64": {"type": "string", "minLength": 1}
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["capture-http", "verify-offline", "export-bundle", "import-bundle", "history-view", "recovery"]}
    },
    "supported_artifact_types": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["application/wacz", "application/warc", "application/zip"]}
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "base_url"],
      "properties": {
        "transport": {"enum": ["file", "https", "http"]},
        "base_url": {"type": "string", "minLength": 1}
      }
    }
  }
}
